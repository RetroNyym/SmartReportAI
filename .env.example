# SQL Server (config/connections.yaml -> main_sql)
SQL_SERVER=localhost
SQL_DATABASE=YourDatabase
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_TRUSTED=true
SQL_USER=
SQL_PASSWORD=

# MySQL (mysql_main)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# PostgreSQL (postgres_main)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=

# SQLite (local_sqlite)
SQLITE_PATH=data/local.db

# Dil: tr | en | fr | es | it | de
LANGUAGE=tr

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Çıktı ve Outlook
REPORT_DIR=output
MAIL_TO=
MAIL_CC=
MAIL_SUBJECT_PREFIX=[SmartReportAI]
MAIL_TEMPLATE=email.html
